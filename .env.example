# Aplicação
NODE_ENV=development
API_PORT=4100
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Base de dados
DATABASE_URL=postgresql://smartcampus:smartcampus@localhost:5432/smart_campus?schema=public

# JWT (valores de demonstração — nunca usar em produção)
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:4100/api/v1
