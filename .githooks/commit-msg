#!/usr/bin/env bash
# Remove atribuições Cursor injectadas automaticamente pelo IDE.
MSG_FILE="$1"
sed -i '' \
  -e '/^Co-authored-by: Cursor /d' \
  -e '/^Made-with: Cursor/d' \
  -e '/^Made with Cursor/d' \
  -e '/^Built by Cursor/d' \
  "$MSG_FILE" 2>/dev/null || sed -i \
  -e '/^Co-authored-by: Cursor /d' \
  -e '/^Made-with: Cursor/d' \
  -e '/^Made with Cursor/d' \
  -e '/^Built by Cursor/d' \
  "$MSG_FILE"
